# Reviewed after the v0.1.170 upstream merge. Includes compatibility tests that
# intentionally cover site-specific scheduler, billing, and frontend overlays.
UPSTREAM_HANDWRITTEN_OVERLAP_MAX := 302
FRONTEND_NODE_OPTIONS := NODE_OPTIONS=--max-old-space-size=4096

build-datamanagementd:
	@cd datamanagement && go build -o datamanagementd ./cmd/datamanagementd

test-datamanagementd:
	@cd datamanagement && go test ./...

upstream-delta:
	@python3 tools/upstream_delta.py --local HEAD --upstream upstream/main --fetch

upstream-check:
	@python3 tools/upstream_delta.py --local HEAD --upstream upstream/main --check --require-clean --max-handwritten-overlap $(UPSTREAM_HANDWRITTEN_OVERLAP_MAX)
	@PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tools -p 'test_upstream_*.py'
	@PYTHONDONTWRITEBYTECODE=1 python3 tools/audit_upstream_owned.py --check --local HEAD --upstream upstream/main
	@PYTHONDONTWRITEBYTECODE=1 python3 tools/audit_upstream_overlay.py --check --local HEAD --upstream upstream/main
	@node tools/audit_i18n_overlay.cjs --check --upstream=upstream/main

upstream-verify-frontend: upstream-check
	@$(FRONTEND_NODE_OPTIONS) pnpm --dir frontend run lint:check
	@$(FRONTEND_NODE_OPTIONS) pnpm --dir frontend run typecheck
	@$(FRONTEND_NODE_OPTIONS) pnpm --dir frontend run test:run
	@$(FRONTEND_NODE_OPTIONS) pnpm --dir frontend run build
	@git diff --check

upstream-sync-prepare:
	@python3 tools/upstream_sync.py prepare --local HEAD --upstream upstream/main --fetch

upstream-owned-policy-refresh:
	@python3 tools/audit_upstream_owned.py --local HEAD --upstream upstream/main --write-policy --reviewed

upstream-overlay-policy-refresh:
	@python3 tools/audit_upstream_overlay.py --local HEAD --upstream upstream/main --write-policy --reviewed
